# Environment variables for the House Price Prediction backend
# Copy this file to .env and fill in actual values.

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Absolute path to the trained model file
# Default auto-resolves to <project_root>/models/house_price.pkl
# MODEL_PATH=/absolute/path/to/house_price.pkl

# Absolute path to the locations JSON
# Default auto-resolves to <backend>/app/locations.json
# LOCATIONS_PATH=/absolute/path/to/locations.json

# Comma-separated origins allowed for CORS
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
